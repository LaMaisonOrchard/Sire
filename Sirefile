DUB = dub build;

PY = <python> ;
CFLAGS = "-IInc" "-I/D/Inc" "-DDEBUG=1" "-DSTATE" "-DBAD=" ;

INCLUDES [ *.h $(CFLAGS) ];
INCLUDES [ *.cpp $(CFLAGS) ];

SRC = 'source/*.d';
ID  = $(PLATFORM)_$(OS);
FRED = $(SRC);

TARGET : ../Sire sire-test$(EXE) output/$(ID)/sire$(EXE) fred.cpp;

../Sire : CREATE :
{
    "$(GIT)" clone -b main --single-branch --recurse-submodules "git@github.com:LaMaisonOrchard/Sire.git" $(TARGET)
}

../Sire : TOUCH :
{
    cd $(TARGET)
    "$(GIT)" pull origin
}

sire-test$(EXE) : $(SRC)
{
    echo Build : ${TARGET}
    ${DC} -unittest -of=$(TARGET) $(DEPS)
    ./$(TARGET)
}

*/$(ID)/sire$(EXE) : $(SRC)
{
    echo Build : ${TARGET}
    mkdir $(0)/$(ID)
    ${DC} -of=$(TARGET) $(DEPS)

    cp $(0) $(0)2

    cd ..
    echo $(PWD)
}

PRE : QUIET :
{
    echo "hello world"
    echo $(PWD)
    echo "$(ID)
    echo output/$(ID)/sire$(EXE) fred.cpp
    echo $(FRED)
    
}

POST : QUIET :
{
    echo "goodbye"
    echo $(PWD)
}

FAILED : QUIET :
{
    echo "ERROR"
}


