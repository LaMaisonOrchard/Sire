DUB = dub build;

PY = <python> ;
CFLAGS = "-I=Inc" ;

GIT [ Test ../Sire "git@github.com:LaMaisonOrchard/Sire.git" main ] fred harry;
GIT [ Repo ../Sire "git@github.com:LaMaisonOrchard/Sire.git" main ];
INCLUDES [ *.h ${CFLAGS} ];
INCLUDES [ *.cpp ${CFLAGS} ];

SRC = 'source/*.d';
ID  = ${PLATFORM}_${OS};

TARGET : output/${ID}/sire${EXE} fred.cpp;

*/${ID}/sire${EXE} : ${SRC}
{
    echo Build : ${TARGET}
    mkdir ${0}/${ID}
    ${DC} -of=${TARGET} ${DEPS}

    cp ${0} ${0}2

    cd ..
    echo $(PWD)
}

PRE : QUIET :
{
    echo "hello world"
    echo $(PWD)
}

POST : QUIET :
{
    echo "goodbye"
    echo $(PWD)
}

FAILED : QUIET :
{
    echo "ERROR"
}


